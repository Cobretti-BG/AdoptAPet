@model IEnumerable<AdoptionRequestViewModel>

@{
    ViewData["Title"] = "My Adoption Requests";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">My Adoption Requests</h1>
            <p class="text-muted mb-0">
                Track the status of the pets you have requested to adopt.
            </p>
        </div>

        <a asp-controller="Pets"
           asp-action="Index"
           class="btn btn-outline-primary">
            Browse Pets
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @successMessage
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @errorMessage
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h2 class="h5">No adoption requests yet</h2>
                <p class="text-muted">
                    When you find a pet you'd like to adopt, you can submit a request from its details page.
                </p>
                <a asp-controller="Pets"
                   asp-action="Index"
                   class="btn btn-primary">
                    Find a Pet
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Pet</th>
                        <th scope="col">Message</th>
                        <th scope="col">Submitted</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdoptionRequestViewModel request in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Pets"
                                   asp-action="Details"
                                   asp-route-id="@request.PetId"
                                   class="text-decoration-none fw-semibold">
                                    @(string.IsNullOrWhiteSpace(request.PetName)
                                        ? request.PetSpecies
                                        : request.PetName)
                                </a>
                            </td>
                            <td>
                                <span class="d-inline-block text-break"
                                      style="max-width: 300px;">
                                    @request.Message
                                </span>
                            </td>
                            <td>
                                @request.CreatedOn.ToString("dd.MM.yyyy")
                            </td>
                            <td>
                                <span class="badge rounded-pill
                                    @(request.Status == AdoptionRequestStatus.Pending
                                        ? "text-bg-warning"
                                        : request.Status == AdoptionRequestStatus.Approved
                                            ? "text-bg-success"
                                            : request.Status == AdoptionRequestStatus.Rejected
                                                ? "text-bg-danger"
                                                : "text-bg-secondary")">
                                    @request.Status
                                </span>
                            </td>
                            <td>
                                @if (request.Status == AdoptionRequestStatus.Pending)
                                {
                                    <form asp-controller="AdoptionRequests"
                                          asp-action="Cancel"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this adoption request?');">
                                        <input type="hidden"
                                               name="requestId"
                                               value="@request.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>