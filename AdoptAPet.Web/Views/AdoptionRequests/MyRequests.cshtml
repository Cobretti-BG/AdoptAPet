@model IEnumerable<AdoptionRequestViewModel>

@{
    ViewData["Title"] = "My Adoption Requests";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between
        align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">My Adoption Requests</h1>
            <p class="text-muted mb-0">
                Track the status of the pets you have requested to adopt.
            </p>
        </div>

        <a asp-controller="Pets"
           asp-action="Index"
           class="btn btn-outline-success">
            Browse pets
        </a>
    </div>

    <partial name="_Notification" />

    @if (!Model.Any())
    {
        <div class="empty-state text-center p-4 p-md-5">
            <div class="empty-state-icon mb-3" aria-hidden="true">🐾</div>

            <h2 class="h4">No adoption requests yet</h2>

            <p class="text-muted mb-4">
                When you find a pet you'd love to adopt, you can send a
                request from its details page.
            </p>

            <a asp-controller="Pets"
               asp-action="Index"
               class="btn btn-success">
                Find a pet
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive adoption-requests-table">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Pet</th>
                        <th scope="col">Your message</th>
                        <th scope="col">Submitted</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdoptionRequestViewModel request in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Pets"
                                   asp-action="Details"
                                   asp-route-id="@request.PetId"
                                   class="text-decoration-none fw-semibold pet-request-link">
                                    @(string.IsNullOrWhiteSpace(request.PetName)
                                        ? request.PetSpecies
                                        : request.PetName)
                                </a>
                            </td>

                            <td class="request-message">
                                @request.Message
                            </td>

                            <td class="text-nowrap">
                                @request.CreatedOn.ToString(DateTimeFormat)
                            </td>

                            <td>
                                @if (request.Status == AdoptionRequestStatus.Pending)
                                {
                                    <span class="badge rounded-pill text-bg-warning">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == AdoptionRequestStatus.Approved)
                                {
                                    <span class="badge rounded-pill text-bg-success">
                                        Approved
                                    </span>
                                }
                                else if (request.Status == AdoptionRequestStatus.Rejected)
                                {
                                    <span class="badge rounded-pill text-bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">
                                        @request.Status
                                    </span>
                                }
                            </td>

                            <td>
                                @if (request.Status == AdoptionRequestStatus.Pending)
                                {
                                    <form asp-controller="AdoptionRequests"
                                          asp-action="Cancel"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this adoption request?');">
                                        <input type="hidden"
                                               name="requestId"
                                               value="@request.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
