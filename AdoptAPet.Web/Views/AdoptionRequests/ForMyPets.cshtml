@model IEnumerable<AdoptionRequestViewModel>

@{
    ViewData["Title"] = "Adoption Requests for My Pet";
    int petId = (int)(ViewData["PetId"] ?? 0);
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between
        align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">Adoption Requests</h1>
            <p class="text-muted mb-0">
                Review applications from people wanting to give your pet a loving home.
            </p>
        </div>

        <a asp-controller="Pets"
           asp-action="Details"
           asp-route-id="@petId"
           class="btn btn-outline-secondary">
            Back to pet
        </a>
    </div>

    <partial name="_Notification" />

    @if (!Model.Any())
    {
        <div class="empty-state text-center p-4 p-md-5">
            <div class="empty-state-icon mb-3" aria-hidden="true">🐾</div>

            <h2 class="h4">No requests yet</h2>

            <p class="text-muted mb-0">
                There are currently no adoption requests for this pet.
                When someone applies, their message will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (AdoptionRequestViewModel request in Model)
            {
                <div class="col-12">
                    <article class="card adoption-request-card">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex flex-column flex-sm-row
                                justify-content-between align-items-sm-start gap-3">
                                <div>
                                    <h2 class="h5 mb-1">
                                        @(request.ApplicantUserName ?? "Unknown applicant")
                                    </h2>

                                    <p class="text-muted small mb-0">
                                        Submitted on
                                        @request.CreatedOn.ToString(DateTimeFormat)
                                    </p>
                                </div>

                                @if (request.Status == AdoptionRequestStatus.Pending)
                                {
                                    <span class="badge rounded-pill text-bg-warning">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == AdoptionRequestStatus.Approved)
                                {
                                    <span class="badge rounded-pill text-bg-success">
                                        Approved
                                    </span>
                                }
                                else if (request.Status == AdoptionRequestStatus.Rejected)
                                {
                                    <span class="badge rounded-pill text-bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">
                                        @request.Status
                                    </span>
                                }
                            </div>

                            <hr class="my-3" />

                            <h3 class="h6 mb-2">Applicant's message</h3>
                            <p class="request-message mb-4">@request.Message</p>

                            @if (request.Status == AdoptionRequestStatus.Pending)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-controller="AdoptionRequests"
                                          asp-action="Approve"
                                          method="post"
                                          onsubmit="return confirm('Approve this adoption request? The pet will be marked as adopted.');">
                                        <input type="hidden"
                                               name="requestId"
                                               value="@request.Id" />

                                        <input type="hidden"
                                               name="petId"
                                               value="@petId" />

                                        <button type="submit" class="btn btn-success">
                                            Approve request
                                        </button>
                                    </form>

                                    <form asp-controller="AdoptionRequests"
                                          asp-action="Reject"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to reject this adoption request?');">
                                        <input type="hidden"
                                               name="requestId"
                                               value="@request.Id" />

                                        <input type="hidden"
                                               name="petId"
                                               value="@petId" />

                                        <button type="submit" class="btn btn-outline-danger">
                                            Reject request
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
