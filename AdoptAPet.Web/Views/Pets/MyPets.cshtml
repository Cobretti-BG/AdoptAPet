@model IEnumerable<PetListingViewModel>

@{
    ViewData["Title"] = "My Pets";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">My Pets</h1>
            <p class="text-muted mb-0">
                Manage the pets you have listed for adoption.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Browse All Pets
            </a>

            <a asp-action="Create" class="btn btn-primary">
                Add a Pet
            </a>
        </div>
    </div>

    <partial name="_Notification" />

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h2 class="h5">You haven't listed any pets yet</h2>
                <p class="text-muted">
                    Add a pet to help it find a loving home.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    List a Pet
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var pet in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(pet.ImageUrl))
                        {
                            <img src="@pet.ImageUrl"
                                 class="card-img-top"
                                 alt="Photo of @(pet.Name ?? pet.Species)"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">No image available</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 card-title">
                                @(string.IsNullOrWhiteSpace(pet.Name)
                                    ? pet.Species
                                    : pet.Name)
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(pet.Breed))
                            {
                                <p class="text-muted mb-2">@pet.Breed</p>
                            }

                            <p class="mb-1">
                                <strong>Gender:</strong> @pet.Gender
                            </p>

                            <p class="mb-3">
                                <strong>Location:</strong> @pet.Location
                            </p>

                            <div class="mt-auto">
                                <a asp-action="Details"
                                   asp-route-id="@pet.Id"
                                   class="btn btn-outline-primary w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>