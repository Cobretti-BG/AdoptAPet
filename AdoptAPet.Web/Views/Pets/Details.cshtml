@model PetDetailsViewModel

@{
    ViewData["Title"] = "Pet details";
}

<div class="container py-4">
    <a asp-action="Index" class="btn btn-link px-0 mb-3">
        &larr; Back to available pets
    </a>

    <div class="row g-4">
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }
        <div class="col-md-5">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     class="img-fluid rounded shadow-sm w-100"
                     alt="Photo of @(Model.Name ?? Model.Species)"
                     style="max-height: 500px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center
                    justify-content-center"
                     style="min-height: 300px;">
                    <span class="text-muted">No photo available</span>
                </div>
            }
        </div>

        <div class="col-md-7">
            <h1>
                @(string.IsNullOrWhiteSpace(Model.Name)
                    ? Model.Species
                    : Model.Name)
            </h1>

            <p class="text-muted fs-5">
                @Model.Species
                @if (!string.IsNullOrWhiteSpace(Model.Breed))
                {
                    <span> · @Model.Breed</span>
                }
            </p>

            <dl class="row">
                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.Gender</dd>

                <dt class="col-sm-4">Date of birth</dt>
                <dd class="col-sm-8">
                    @(Model.DateOfBirth?.ToString("dd.MM.yyyy") ?? "Unknown")
                </dd>

                <dt class="col-sm-4">Color</dt>
                <dd class="col-sm-8">
                    @(Model.Color ?? "Unknown")
                </dd>

                <dt class="col-sm-4">Location</dt>
                <dd class="col-sm-8">@Model.Location</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>

            <h2 class="h4 mt-4">About this pet</h2>
            <p style="white-space: pre-line;">@Model.Description</p>

            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex flex-wrap gap-2 mt-4">
                    @if (Model.Status == AdoptAPet.Data.Models.Enums.PetStatus.Available
                        && !Model.IsOwner)
                    {
                        <a asp-controller="AdoptionRequests"
                           asp-action="Create"
                           asp-route-petId="@Model.Id"
                           class="btn btn-success">
                            Apply to adopt
                        </a>
                    }

                    @if (Model.IsOwner)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">
                            Edit listing
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-danger">
                            Delete listing
                        </a>
                    }
                </div>
            }

        </div>
    </div>
</div>
