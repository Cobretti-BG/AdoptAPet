@model PetDetailsViewModel

@{
    ViewData["Title"] = "Pet details";

    string displayName = string.IsNullOrWhiteSpace(Model.Name)
        ? Model.Species
        : Model.Name;
}

<div class="container py-4">
    <partial name="_Notification" />

    <a asp-action="Index" class="btn btn-link px-0 mb-3">
        &larr; Back to available pets
    </a>

    <div class="row g-4 g-lg-5">
        <div class="col-md-5">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     class="img-fluid rounded-3 shadow-sm w-100 pet-details-image"
                     alt="Photo of @displayName" />
            }
            else
            {
                <div class="pet-details-placeholder rounded-3 d-flex
                    flex-column align-items-center justify-content-center"
                     role="img"
                     aria-label="No photo available">
                    <span aria-hidden="true">🐾</span>
                    <span>No photo available</span>
                </div>
            }
        </div>

        <div class="col-md-7">
            <h1 class="mb-2">@displayName</h1>

            <p class="text-muted fs-5 mb-4">
                @Model.Species
                @if (!string.IsNullOrWhiteSpace(Model.Breed))
                {
                    <span> · @Model.Breed</span>
                }
            </p>

            <div class="mb-4">
                <span class="text-muted me-2">Adoption status:</span>

                @if (Model.Status == PetStatus.Available)
                {
                    <span class="badge text-bg-success">Available</span>
                }
                else if (Model.Status == PetStatus.PendingAdoption)
                {
                    <span class="badge text-bg-warning">Pending adoption</span>
                }
                else if (Model.Status == PetStatus.Adopted)
                {
                    <span class="badge text-bg-secondary">Adopted</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">@Model.Status</span>
                }
            </div>

            <div class="pet-details-information p-3 p-md-4 rounded-3">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Gender</dt>
                    <dd class="col-sm-8">@Model.Gender</dd>

                    <dt class="col-sm-4">Date of birth</dt>
                    <dd class="col-sm-8">
                        @(Model.DateOfBirth?.ToString("dd.MM.yyyy") ?? "Unknown")
                    </dd>

                    <dt class="col-sm-4">Color</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Color)
                            ? "Unknown"
                            : Model.Color)
                    </dd>

                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@Model.Location</dd>
                </dl>
            </div>

            <h2 class="h4 mt-4 mb-3">About this pet</h2>

            <p class="pet-details-description">@Model.Description</p>

            <div class="d-flex flex-wrap gap-2 mt-4">
                @if (Model.Status == PetStatus.Available && !Model.IsOwner)
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="AdoptionRequests"
                           asp-action="Create"
                           asp-route-petId="@Model.Id"
                           class="btn btn-success">
                            Apply to adopt
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@Url.Action(
                                              "Create",
                                              "AdoptionRequests",
                                              new { petId = Model.Id })"
                           class="btn btn-success">
                            Apply to adopt
                        </a>
                    }
                }

                @if (Model.IsOwner)
                {
                    <a asp-controller="AdoptionRequests"
                       asp-action="ForMyPets"
                       asp-route-petId="@Model.Id"
                       class="btn btn-outline-success">
                        View adoption requests
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Edit listing
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-danger">
                        Delete listing
                    </a>
                }
            </div>
        </div>
    </div>
</div>
