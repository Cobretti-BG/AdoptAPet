@model PetDetailsViewModel

@{
    ViewData["Title"] = "Delete pet listing";

    string displayName = string.IsNullOrWhiteSpace(Model.Name)
        ? Model.Species
        : Model.Name;
}

<div class="container py-4">
    <div class="pet-delete-container mx-auto">
        <h1 class="mb-2">Delete pet listing</h1>

        <p class="text-muted mb-4">
            Review the listing before confirming its deletion.
        </p>

        <div class="alert alert-warning d-flex gap-3 align-items-start"
             role="alert">
            <span class="fs-4" aria-hidden="true">⚠</span>
            <div>
                <strong>Are you sure?</strong>
                <p class="mb-0">
                    This listing will be permanently deleted. This action
                    cannot be undone.
                </p>
            </div>
        </div>

        <div class="pet-form-card p-3 p-md-4 mb-4">
            <h2 class="h4 mb-3">@displayName</h2>

            <dl class="row mb-0">
                <dt class="col-sm-4">Species</dt>
                <dd class="col-sm-8">@Model.Species</dd>

                <dt class="col-sm-4">Location</dt>
                <dd class="col-sm-8">@Model.Location</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>
        </div>

        <form asp-action="DeleteConfirmed"
              asp-route-id="@Model.Id"
              method="post">
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger">
                    Delete listing
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
