@model PetDetailsViewModel

@{
    ViewData["Title"] = "Delete pet listing";
}

<div class="container py-4">
    <h1>Delete pet listing</h1>

    <div class="alert alert-warning mt-3">
        Are you sure you want to delete this listing? This action cannot be undone.
    </div>

    <div class="card mb-4" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="h4">
                @(string.IsNullOrWhiteSpace(Model.Name)
                    ? Model.Species
                    : Model.Name)
            </h2>

            <p class="mb-1"><strong>Species:</strong> @Model.Species</p>
            <p class="mb-1"><strong>Location:</strong> @Model.Location</p>
            <p class="mb-0"><strong>Status:</strong> @Model.Status</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed"
          asp-route-id="@Model.Id"
          method="post">
        <button type="submit" class="btn btn-danger">
            Yes, delete listing
        </button>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </form>
</div>
