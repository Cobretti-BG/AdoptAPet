@model PetFormViewModel

@{
    ViewData["Title"] = "Edit pet listing";
}

<div class="container py-4">
    <div class="pet-form-container mx-auto">
        <div class="mb-4">
            <h1 class="mb-2">Edit pet listing</h1>
            <p class="text-muted mb-0">
                Keep the pet's information up to date.
            </p>
        </div>

        <div class="pet-form-card p-3 p-md-4">
            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <partial name="_PetFormFields" model="Model" />

                <div class="mt-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        Save changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
