@model IEnumerable<PetListingViewModel>

@{
    ViewData["Title"] = "Pets available for adoption";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Pets looking for a home</h1>
            <p class="text-muted mb-0">
                Meet your new best friend.
            </p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary">
                Add a pet
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            There are no pets available for adoption right now.
            Please check again later.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (PetListingViewModel pet in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(pet.ImageUrl))
                        {
                            <img src="@pet.ImageUrl"
                                 class="card-img-top"
                                 alt="Photo of @(pet.Name ?? pet.Species)"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center
                                justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">No photo available</span>
                            </div>
                        }

                        <div class="card-body">
                            <h2 class="card-title h5">
                                @(string.IsNullOrWhiteSpace(pet.Name)
                                    ? pet.Species
                                    : pet.Name)
                            </h2>

                            <p class="text-muted mb-2">
                                @pet.Species
                                @if (!string.IsNullOrWhiteSpace(pet.Breed))
                                {
                                    <span> · @pet.Breed</span>
                                }
                            </p>

                            <p class="mb-1">
                                <strong>Gender:</strong> @pet.Gender
                            </p>

                            <p class="mb-3">
                                <strong>Location:</strong> @pet.Location
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@pet.Id"
                               class="btn btn-outline-primary">
                                View details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
