@model IEnumerable<PetListingViewModel>

@{
    ViewData["Title"] = "Pets available for adoption";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between
        align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">Pets looking for a home</h1>
            <p class="text-muted mb-0">
                Meet your new best friend.
            </p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-success">
                Add a pet
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state text-center p-4 p-md-5">
            <div class="empty-state-icon mb-3" aria-hidden="true">🐾</div>

            <h2 class="h4">No pets available just yet</h2>

            <p class="text-muted mb-4">
                We're waiting for more lovely pets to find their forever homes.
                Please check back soon.
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Pets"
                   asp-action="Create"
                   class="btn btn-outline-success">
                    Add the first pet
                </a>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (PetListingViewModel pet in Model)
            {
                <div class="col">
                    <div class="card pet-card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(pet.ImageUrl))
                        {
                            <img src="@pet.ImageUrl"
                                 class="card-img-top pet-card-image"
                                 alt="Photo of @(pet.Name ?? pet.Species)"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="pet-card-placeholder d-flex
                                align-items-center justify-content-center"
                                 role="img"
                                 aria-label="No photo available">
                                <span aria-hidden="true">🐾</span>
                                <span>No photo available</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title h5 mb-2">
                                @(string.IsNullOrWhiteSpace(pet.Name)
                                    ? pet.Species
                                    : pet.Name)
                            </h2>

                            <p class="text-muted mb-3">
                                @pet.Species
                                @if (!string.IsNullOrWhiteSpace(pet.Breed))
                                {
                                    <span> · @pet.Breed</span>
                                }
                            </p>

                            <p class="mb-2">
                                <strong>Gender:</strong> @pet.Gender
                            </p>

                            <p class="mb-4">
                                <strong>Location:</strong> @pet.Location
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@pet.Id"
                               class="btn btn-outline-success mt-auto">
                                View details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
