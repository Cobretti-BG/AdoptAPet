@model PetFormViewModel

@{
    ViewData["Title"] = "Add a pet";
}

<div class="container py-4">
    <div class="pet-form-container mx-auto">
        <div class="mb-4">
            <h1 class="mb-2">Add a pet for adoption</h1>
            <p class="text-muted mb-0">
                Help a pet find a loving home by sharing a few details.
            </p>
        </div>

        <div class="pet-form-card p-3 p-md-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <partial name="_PetFormFields" model="Model" />

                <div class="mt-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        Publish listing
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
